<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_glass">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/tv_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start"
            android:maxLines="1" android:textColor="@color/w_text2" android:shadowColor="@color/w_glow" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:text="NetMonitor" />
        <TextView android:id="@+id/tv_net" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end"
            android:maxLines="1" android:textColor="@color/w_text2" android:shadowColor="@color/w_glow" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:orientation="horizontal">
        <TextView android:id="@+id/tv_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start"
            android:maxLines="1" android:textColor="@color/w_down" android:shadowColor="@color/w_glow" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start"
            android:maxLines="1" android:textColor="@color/w_up" android:shadowColor="@color/w_glow" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/iv_graph" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5"
        android:layout_marginTop="4dp" android:scaleType="fitXY" android:contentDescription="@null" />
</LinearLayout>
