<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_glass_preview">
    <TextView android:id="@+id/tv_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="This month" android:textColor="@color/wp_text2" android:textSize="11sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <ImageView android:src="@drawable/widget_preview_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.4" android:textColor="@color/wp_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GB" android:textColor="@color/wp_text2" android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/tv_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"
        android:gravity="center" android:textColor="@color/wp_text2" android:textSize="11sp" android:text="WiFi 65% · Mobile 35%" />
</LinearLayout>
