<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#8CFFFFFF" android:endColor="#1FFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:height="44dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#003C46A0" android:endColor="#383C46A0" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#80FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#40FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#1F6B7A99" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <stroke android:width="1.4dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:left="24dp" android:right="24dp" android:top="1dp" android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#FFFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
