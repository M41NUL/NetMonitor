<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFF8FAFD" android:endColor="#FFDCE3EE" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:height="52dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#4D6B7A99" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <stroke android:width="1.2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
</layer-list>
